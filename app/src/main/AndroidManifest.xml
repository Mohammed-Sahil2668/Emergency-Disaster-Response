<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_emergency_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_emergency_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.EmergencyResponse">

        <!-- Screen 1: Splash Screen (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Onboarding Screen -->
        <activity
            android:name=".activities.OnboardingActivity"
            android:exported="true" />

        <!-- Screen 3: Login Screen -->
        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 4: Registration Screen -->
        <activity
            android:name=".activities.RegisterActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 5: Citizen Home Dashboard Container -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan" />

        <!-- Screen 6: Report Emergency Screen -->
        <activity
            android:name=".activities.ReportEmergencyActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 7: Emergency Location Screen -->
        <activity
            android:name=".activities.EmergencyLocationActivity"
            android:exported="true" />

        <!-- Screen 9: Emergency Report Details Screen -->
        <activity
            android:name=".activities.EmergencyReportDetailsActivity"
            android:exported="true" />

        <!-- Authority Screens -->
        <activity
            android:name=".activities.AuthorityMainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".activities.AuthorityEmergencyDetailsActivity"
            android:exported="true" />

        <activity
            android:name=".activities.AssignOfficerActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".activities.OfficerDetailsActivity"
            android:exported="true" />

        <!-- Officer Screens -->
        <activity
            android:name=".activities.OfficerMainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan" />

        <activity
            android:name=".activities.OfficerTaskDetailsActivity"
            android:exported="true" />

        <activity
            android:name=".activities.OfficerEditProfileActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
