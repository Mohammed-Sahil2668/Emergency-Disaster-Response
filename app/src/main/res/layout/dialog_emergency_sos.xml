<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="@dimen/spacing_24">

    <!-- SOS Beacon Icon -->
    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_badge_status"
        android:backgroundTint="@color/status_responding_bg"
        android:contentDescription="SOS"
        android:padding="12dp"
        android:src="@drawable/ic_sos"
        app:tint="@color/emergency_red" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:text="BROADCAST EMERGENCY SOS?"
        android:textColor="@color/emergency_red"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="This will immediately transmit your high-accuracy GPS coordinates (12.9716° N, 77.5946° E) and citizen profile to the nearest active Quick Disaster Response Unit."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Radio / Category selection for SOS -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Select Crisis Type:"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgSosType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp">

        <RadioButton
            android:id="@+id/rbMedical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Medical / Life Threat"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbFire"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fire / Explosion Hazard"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbDisaster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Flood / Cyclone / Landslide Entrapment"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

    </RadioGroup>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelSos"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmSos"
            style="@style/Widget.EmergencyResponse.Button.Emergency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1.5"
            android:text="CONFIRM SOS" />

    </LinearLayout>

</LinearLayout>
