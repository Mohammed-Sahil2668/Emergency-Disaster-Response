<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <!-- Timeline Indicator Column (Dot + Line) -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Dot / Icon -->
        <FrameLayout
            android:id="@+id/flTimelineIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_badge_status"
            android:backgroundTint="@color/status_resolved">

            <ImageView
                android:id="@+id/ivTimelineCheck"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check_circle"
                android:tint="@color/text_white" />

        </FrameLayout>

        <!-- Vertical Line -->
        <View
            android:id="@+id/vTimelineLine"
            android:layout_width="2dp"
            android:layout_height="40dp"
            android:background="@color/divider_color" />

    </LinearLayout>

    <!-- Timeline Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTimelineTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="1. Reported by Citizen"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTimelineTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="14:30"
                android:textColor="@color/text_tertiary"
                android:textSize="12sp" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tvTimelineDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Incident received and queued for immediate verification."
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
