<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/navy_primary"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbarLocation"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/text_white"
            app:title="@string/location_screen_title"
            app:titleTextColor="@color/text_white" />

    </com.google.android.material.appbar.AppBarLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Map Section Container (Prepared for Google Maps SDK) -->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottomLocationCard"
            android:background="@drawable/bg_map_placeholder">

            <!-- Tactical Map Grid / Mock Map Texture -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/ivMapPin"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="Incident Pin"
                    android:src="@drawable/ic_location_pin" />

                <!-- Coordinate Pill on Map -->
                <TextView
                    android:id="@+id/tvPinCoordinates"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_badge_status"
                    android:backgroundTint="@color/navy_primary"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="12.9716° N, 77.5946° E"
                    android:textColor="@color/text_white"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Top Notice Banner -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:background="#D90B192C"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/map_api_notice"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Floating Map Controls on Right -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- Zoom In -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabZoomIn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:contentDescription="Zoom In"
                    app:backgroundTint="@color/bg_surface"
                    app:fabCustomSize="40dp"
                    app:srcCompat="@drawable/ic_refresh"
                    app:tint="@color/navy_primary" />

                <!-- Current Location FAB -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/fabMyLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="Current Location"
                    app:backgroundTint="@color/emergency_red"
                    app:fabCustomSize="44dp"
                    app:srcCompat="@drawable/ic_gps_fixed"
                    app:tint="@color/text_white" />

            </LinearLayout>

        </FrameLayout>

        <!-- Bottom Sheet Location Details Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomLocationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="@dimen/corner_large"
            app:cardElevation="8dp"
            app:strokeColor="@color/card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_20">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_selected_location"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- Location Address Field -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:hint="Selected Address">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSelectedAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/default_location"
                        android:textSize="13sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Latitude & Longitude Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_16"
                    android:orientation="horizontal">

                    <!-- Latitude -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:hint="@string/label_latitude">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLatitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal|numberSigned"
                            android:text="12.9716"
                            android:textSize="13sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Longitude -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:hint="@string/label_longitude">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLongitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal|numberSigned"
                            android:text="77.5946"
                            android:textSize="13sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Use Current Location & Confirm Buttons -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirmLocation"
                    style="@style/Widget.EmergencyResponse.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_confirm_location" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
