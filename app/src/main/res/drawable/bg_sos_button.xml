<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/emergency_red_dark">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="@color/emergency_red"
                android:endColor="@color/emergency_red_dark"
                android:type="linear" />
            <stroke
                android:width="4dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
</ripple>
