<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Map Base Layer -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="45"
                android:startColor="#E2E8F0"
                android:endColor="#CBD5E1"
                android:type="linear" />
            <corners android:radius="@dimen/corner_medium" />
            <stroke
                android:width="1.5dp"
                android:color="@color/navy_secondary" />
        </shape>
    </item>
</layer-list>
